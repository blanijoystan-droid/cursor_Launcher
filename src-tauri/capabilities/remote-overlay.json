{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-overlay",
  "description": "Allow overlay window on remote websites to emit close event",
  "windows": ["overlay"],
  "remote": {
    "urls": ["https://*/*", "http://*/*", "https://*", "http://*"]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-emit"
  ]
}
